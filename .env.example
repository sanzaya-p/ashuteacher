# 1. Database (SQLite locally; switch provider="postgresql" for Neon/Supabase in cloud)
DATABASE_URL="file:./dev.db"

# 2. Auth Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="change-me-to-a-long-random-hex-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Google Gemini AI Engine (Get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# 4. Optional: Google 1-Click OAuth 2.0 (₹0 free forever in Google Cloud Console)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Optional: Razorpay (India UPI / QR / Cards — ₹0 monthly fee)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# 6. Optional: Lemon Squeezy / Global Hosted Checkout (USD Cards / Apple Pay — ₹0 monthly fee)
LEMONSQUEEZY_STARTER_URL=""
LEMONSQUEEZY_CRAM_URL=""
LEMONSQUEEZY_SCHOLAR_URL=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
